# Release lanes, run by the TestFlight and App Store workflows on macOS runners.
# Locally they need the same environment variables the workflows pass in.

require "tmpdir"

default_platform(:ios)

TEAM_ID = "KWZTWNA57G"
PROJECT = "WindRun.xcodeproj"
SCHEME = "WindRun"

# Every target that ends up in the .ipa, with its bundle identifier.
SIGNED_TARGETS = {
  "WindRun" => "com.stanleycloud.WindRun",
  "WindRunWatch" => "com.stanleycloud.WindRun.watchkitapp",
  "WindRunLiveActivity" => "com.stanleycloud.WindRun.LiveActivity",
}.freeze
APP_IDENTIFIER = SIGNED_TARGETS.fetch("WindRun")

platform :ios do
  desc "Build from staging, upload to TestFlight and hand it to the beta groups"
  lane :beta do
    groups = ENV.fetch("TESTFLIGHT_GROUPS", "").split(",").map(&:strip).reject(&:empty?)
    UI.user_error!("Set the TESTFLIGHT_GROUPS repository variable to the beta group's name.") if groups.empty?

    build = signed_ipa

    upload_to_testflight(
      api_key: build[:api_key],
      app_identifier: APP_IDENTIFIER,
      ipa: build[:ipa],
      groups: groups,
      distribute_external: ENV["TESTFLIGHT_EXTERNAL"] == "true",
      notify_external_testers: true,
      changelog: release_notes,
    )
  end

  desc "Build from prod, upload to App Store Connect and submit it for review"
  lane :release do
    build = signed_ipa

    upload_to_app_store(
      api_key: build[:api_key],
      app_identifier: APP_IDENTIFIER,
      ipa: build[:ipa],
      app_version: build[:version],
      build_number: build[:build_number].to_s,
      submit_for_review: true,
      automatic_release: ENV.fetch("APP_STORE_AUTOMATIC_RELEASE", "true") == "true",
      force: true,
      skip_metadata: true,
      skip_screenshots: true,
      run_precheck_before_submit: false,
      submission_information: { add_id_info_uses_idfa: false },
    )
  end

  # Signs with the Apple Distribution certificate from the secrets, fetching (or
  # making) an App Store profile for each target. The project keeps automatic
  # signing for Xcode; only this checkout is switched to manual.
  private_lane :signed_ipa do
    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_content: ENV.fetch("ASC_KEY_P8_BASE64"),
      is_key_content_base64: true,
    )

    setup_ci
    certificate_path = File.join(Dir.tmpdir, "wind-run-distribution.p12")
    File.binwrite(certificate_path, ENV.fetch("DIST_CERT_P12_BASE64").unpack1("m"))
    import_certificate(
      certificate_path: certificate_path,
      certificate_password: ENV.fetch("DIST_CERT_PASSWORD"),
      keychain_name: ENV.fetch("MATCH_KEYCHAIN_NAME"),
      keychain_password: ENV.fetch("MATCH_KEYCHAIN_PASSWORD"),
    )
    File.delete(certificate_path)

    profiles = SIGNED_TARGETS.to_h do |target, bundle_id|
      get_provisioning_profile(api_key: api_key, app_identifier: bundle_id, team_id: TEAM_ID)
      profile_name = lane_context[SharedValues::SIGH_NAME]
      update_code_signing_settings(
        path: PROJECT,
        targets: [target],
        build_configurations: ["Release"],
        use_automatic_signing: false,
        team_id: TEAM_ID,
        code_sign_identity: "Apple Distribution",
        profile_name: profile_name,
      )
      [bundle_id, profile_name]
    end

    version = get_version_number(xcodeproj: PROJECT, target: "WindRun")
    # One counter for every upload, so staging and prod builds never collide.
    build_number = latest_testflight_build_number(
      api_key: api_key,
      app_identifier: APP_IDENTIFIER,
      initial_build_number: 0,
    ) + 1
    UI.message("Building Wind Run #{version} (#{build_number})")

    ipa = build_app(
      project: PROJECT,
      scheme: SCHEME,
      configuration: "Release",
      clean: true,
      output_directory: "build",
      output_name: "WindRun.ipa",
      export_method: "app-store",
      export_team_id: TEAM_ID,
      export_options: { provisioningProfiles: profiles, uploadSymbols: true },
      xcargs: "CURRENT_PROJECT_VERSION=#{build_number}",
    )

    if ENV["GITHUB_OUTPUT"]
      File.write(ENV["GITHUB_OUTPUT"], "version=#{version}\nbuild=#{build_number}\n", mode: "a")
    end

    { api_key: api_key, ipa: ipa, version: version, build_number: build_number }
  end

  # What's new for testers: the commits this merge brought in, else the last one.
  private_lane :release_notes do
    notes = sh("git log --no-merges --pretty='- %s' HEAD^1..HEAD^2 2>/dev/null || git log -1 --pretty='- %s'", log: false).strip
    notes = sh("git log -1 --pretty='- %s'", log: false).strip if notes.empty?
    notes[0, 3900]
  end
end
